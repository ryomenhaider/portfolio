---
interface Props {
  href: string;
  date: string;
  title: string;
  description: string;
  tags: string[];
}

const { href, date, title, description, tags } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col gap-2.5 rounded-lg border border-border bg-surface p-6 transition-colors duration-150 hover:border-accent/50 hover:bg-surface-2"
>
  <div class="font-mono text-xs text-text-muted">{date}</div>
  <h3 class="font-display text-lg font-bold leading-snug tracking-tight transition-colors group-hover:text-accent-text">
    {title}
  </h3>
  <p class="flex-1 text-sm leading-relaxed text-text-secondary">{description}</p>
  <div class="flex flex-wrap gap-1.5">
    {tags.map((t) => (
      <span class="rounded-md border border-accent/25 bg-accent-soft px-2 py-0.5 font-mono text-[11px] text-accent-text">
        #{t}
      </span>
    ))}
  </div>
</a>