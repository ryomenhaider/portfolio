---
import type { Project } from '../config/projects';
import StatusBadge from './StatusBadge.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section class="border-b border-border">
  <div class="page-container py-14 sm:py-20">
    <div class="flex items-center gap-3 mb-4">
      <StatusBadge status={project.status} />
      <span class="font-mono text-xs text-text-muted">{project.repo.replace('https://github.com/', '')}</span>
    </div>
    <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
      {project.name}
    </h1>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-text-secondary">
      {project.description}
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={`/${project.slug}/docs`} class="btn-primary">
        Read the docs
        <span aria-hidden="true">→</span>
      </a>
      <a href={project.repo} target="_blank" rel="noopener" class="btn-secondary">
        GitHub ↗
      </a>
    </div>
  </div>
</section>