---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { getProject } from '../config/projects';

interface Props {
  slug: string;
  docs: CollectionEntry<'docs'>[];
  current: string;
  title: string;
  description?: string;
}

const { slug, docs, current, title, description } = Astro.props;
const project = getProject(slug);
---

<BaseLayout title={title} description={description} path={current}>
  <div class="flex flex-col lg:flex-row min-h-[calc(100vh-4rem)] bg-[#0a0a0f] text-white">
    <div class="lg:hidden border-b border-white/10 p-3 flex items-center justify-between">
      <a href={`/${slug}`} class="font-black text-lg hover:text-[#a78bfa] transition-colors">
        {project?.name ?? slug} <span class="text-white/40 font-mono text-xs">docs</span>
      </a>
      <span class="text-sm text-white/40 font-mono">{docs.length} sections</span>
    </div>
    <div class="hidden lg:block">
      <Sidebar slug={slug} docs={docs} current={current} />
    </div>
    <main class="flex-1 lg:overflow-y-auto p-5 lg:p-10">
      <div class="max-w-3xl mx-auto doc-content">
        <slot />
        <nav class="mt-16 pt-4 border-t border-white/10 flex justify-between font-mono text-sm">
          <a href={`/${slug}#top`} class="text-white/40 hover:text-[#a78bfa] transition-colors">
            ↑ back to top
          </a>
          <a href="/" class="text-white/40 hover:text-[#a78bfa] transition-colors">
            home
          </a>
        </nav>
      </div>
    </main>
  </div>
</BaseLayout>
