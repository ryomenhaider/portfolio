---
import '../styles/global.css';
import { projects, siteUrl, socials } from '../config/projects';

interface Props {
  title: string;
  description?: string;
  path?: string;
}

const { title, description = 'Haider Ali — portfolio of open-source projects', path = '/' } =
  Astro.props;
const canonical = new URL(path, siteUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='black'/><text x='50' y='68' font-size='60' text-anchor='middle' fill='white' font-family='monospace'>H</text></svg>"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 border-b border-white/10 bg-[#0a0a0f]/85 backdrop-blur-md">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
        <a href="/" class="font-black tracking-tight text-lg text-white hover:text-[#a78bfa] transition-colors">
          haiderali<span class="text-[#a78bfa]">.dev</span>
        </a>
        <nav class="flex flex-wrap items-center gap-1">
          {projects.map((p) => (
            <a
              href={`/${p.slug}`}
              class:list={[
                'px-3 py-1.5 text-sm font-semibold rounded-md transition-colors',
                path.startsWith(`/${p.slug}`)
                  ? 'bg-white text-black'
                  : 'text-white/60 hover:text-white hover:bg-white/10',
              ]}
            >
              {p.name}
            </a>
          ))}
          <a
            href="/blog"
            class:list={[
              'px-3 py-1.5 text-sm font-semibold rounded-md transition-colors',
              path === '/blog' || path.startsWith('/blog/')
                ? 'bg-white text-black'
                : 'text-white/60 hover:text-white hover:bg-white/10',
            ]}
          >
            Blog
          </a>
          <a
            href={socials.github}
            target="_blank"
            class="ml-1 px-3 py-1.5 text-sm font-semibold rounded-md text-white border border-white/25 hover:bg-white hover:text-black transition-colors"
          >
            GitHub ↗
          </a>
        </nav>
      </div>
    </header>

    <div class="flex-1">
      <slot />
    </div>

    <footer class="border-t border-white/10 bg-[#0a0a0f]">
      <div class="max-w-6xl mx-auto px-4 py-5 flex flex-wrap items-center justify-between gap-3 text-sm text-white/60">
        <span>© {new Date().getFullYear()} Haider Ali</span>
        <div class="flex items-center gap-4">
          <a href={socials.linkedin} target="_blank" class="hover:text-white transition-colors">
            LinkedIn
          </a>
          <a href={socials.x} target="_blank" class="hover:text-white transition-colors">
            X
          </a>
          <a href={socials.github} target="_blank" class="hover:text-white transition-colors">
            GitHub
          </a>
          <a href="/blog" class="hover:text-white transition-colors">
            Blog
          </a>
          <span class="text-white/30 font-mono text-xs hidden sm:inline">built with astro</span>
        </div>
      </div>
    </footer>
  </body>
</html>
