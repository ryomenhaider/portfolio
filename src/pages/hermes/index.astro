---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Tag from '../../components/Tag.astro';
import { socials } from '../../config/projects';

const features = [
  {
    title: '10 Data Sources',
    description: 'World Bank, IMF, GDELT, OpenSanctions, FRED, Binance, Finnhub, SEC EDGAR, Yahoo Finance, and bundled datasets — all behind one async API.',
    icon: '🔗',
  },
  {
    title: '58 Country Risk Features',
    description: 'Economic, geopolitical, security, social, and environmental indicators computed concurrently for any ISO3 country.',
    icon: '🌍',
  },
  {
    title: '86-Field Technical Analysis',
    description: 'Crypto technical snapshots from Binance — price, volatility, order book, funding rates, composite scores.',
    icon: '📈',
  },
  {
    title: '71-Field Fundamental Analysis',
    description: 'Stock fundamentals from Finnhub, SEC EDGAR, FRED, and Yahoo Finance — income, balance sheet, valuation, macro context.',
    icon: '📊',
  },
  {
    title: 'Parquet TTL Cache',
    description: 'Every fetch cached to disk with per-source TTLs. SHA-256 keying, hit/miss stats, and manual eviction.',
    icon: '💾',
  },
  {
    title: 'Feature Lineage Graph',
    description: '@feature decorator registers every function in a dependency graph with topological tier resolution.',
    icon: '🔗',
  },
];

const sources = [
  { name: 'World Bank', type: 'Economic' },
  { name: 'IMF', type: 'Economic' },
  { name: 'GDELT', type: 'Geopolitical' },
  { name: 'OpenSanctions', type: 'Sanctions' },
  { name: 'FRED', type: 'US Economic' },
  { name: 'Binance', type: 'Crypto' },
  { name: 'Finnhub', type: 'Stocks' },
  { name: 'SEC EDGAR', type: 'Filings' },
  { name: 'Yahoo Finance', type: 'Stocks' },
  { name: 'Public Datasets', type: 'Static' },
];
---

<BaseLayout title="Hermes — Data Intelligence Platform" description="A foundational intelligence data platform for acquiring, validating, normalizing, storing, and serving country risk and financial intelligence datasets." path="/hermes">
  <!-- HERO -->
  <section class="border-b border-border">
    <div class="page-container py-14 sm:py-20 lg:py-24">
      <div class="flex items-center gap-3 mb-5">
        <StatusBadge status="active" />
        <span class="font-mono text-xs text-text-muted">v0.2.8</span>
      </div>
      <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
        Hermes
      </h1>
      <p class="mt-2 font-mono text-sm text-accent-text">Data Intelligence Platform</p>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-text-secondary">
        A foundational intelligence data platform for acquiring, validating, normalizing, storing, and serving country risk and financial intelligence datasets — one async Python API over 10+ source families.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/hermes/docs" class="btn-primary">
          Read the docs <span aria-hidden="true">→</span>
        </a>
        <a href={socials.github} target="_blank" rel="noopener" class="btn-secondary">GitHub ↗</a>
      </div>

      <div class="mt-10 rounded-lg border border-border bg-surface p-4">
        <p class="mb-2 font-mono text-xs text-text-muted">Install</p>
        <code class="block font-mono text-sm text-text">uv add hermes-plt</code>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="page-container py-16 sm:py-24">
    <p class="mb-2 font-mono text-sm text-accent-text">capabilities</p>
    <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">What it does</h2>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <div class="rounded-lg border border-border bg-surface p-5">
          <div class="text-2xl" aria-hidden="true">{f.icon}</div>
          <h3 class="mt-3 font-display font-bold">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">{f.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- DATA SOURCES -->
  <section class="border-y border-border bg-surface">
    <div class="page-container py-16 sm:py-24">
      <p class="mb-2 font-mono text-sm text-accent-text">sources</p>
      <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">10 data sources, one API</h2>
      <div class="mt-10 overflow-hidden rounded-lg border border-border">
        <div class="grid gap-px bg-border sm:grid-cols-2 lg:grid-cols-5">
          {sources.map((s) => (
            <div class="bg-background p-4">
              <div class="font-display font-bold">{s.name}</div>
              <div class="mt-1 font-mono text-[11px] text-text-muted">{s.type}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- QUICK START -->
  <section class="page-container py-16 sm:py-24">
    <p class="mb-2 font-mono text-sm text-accent-text">quick start</p>
    <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">Up and running in seconds</h2>
    <div class="mt-8 max-w-2xl overflow-hidden rounded-lg border border-border bg-code-bg">
      <div class="flex items-center gap-2 border-b border-border px-4 py-2">
        <span class="h-2.5 w-2.5 rounded-full bg-text-muted/30"></span>
        <span class="font-mono text-xs text-text-muted">example.py</span>
      </div>
      <pre class="overflow-x-auto p-4 font-mono text-sm leading-relaxed"><code><span class="text-text-muted">import</span> asyncio
<span class="text-text-muted">from</span> hermes <span class="text-text-muted">import</span> Hermes

<span class="text-text-muted">async def</span> <span class="text-accent-text">main</span>():
    hr = Hermes(
        opensanction_api=<span class="text-success">"your-key"</span>,
        fred_api=<span class="text-success">"your-key"</span>,
        finnhub_api=<span class="text-success">"your-key"</span>,
        sec_username=<span class="text-success">"you"</span>,
        sec_email=<span class="text-success">"you@example.com"</span>,
    )

    <span class="text-text-muted"># Country risk snapshot</span>
    risk = <span class="text-text-muted">await</span> hr.country_features.get_country_risk_features(<span class="text-success">"USA"</span>)
    <span class="text-text-muted">print</span>(risk[<span class="text-success">"economic"</span>][<span class="text-success">"gdp_growth_yoy"</span>])

    <span class="text-text-muted"># Technical snapshot</span>
    ta = <span class="text-text-muted">await</span> hr.ta_feature.get_technical(<span class="text-success">"BTCUSDT"</span>)
    <span class="text-text-muted">print</span>(ta.trend_score)

asyncio.run(main())</code></pre>
    </div>
    <div class="mt-6">
      <a href="/hermes/docs" class="btn-primary">Read the full docs <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- TECH STACK -->
  <section class="border-t border-border bg-surface">
    <div class="page-container py-16 sm:py-24">
      <p class="mb-2 font-mono text-sm text-accent-text">stack</p>
      <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">Built with</h2>
      <div class="mt-8 flex flex-wrap gap-2">
        {['Python 3.11+', 'aiohttp', 'pandas', 'pyarrow', 'FastParquet', 'pycountry', 'sdmx', 'sec-cik-mapper', 'yfinance'].map((t) => <Tag label={t} />)}
      </div>
    </div>
  </section>
</BaseLayout>