---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Tag from '../../components/Tag.astro';
import { socials } from '../../config/projects';

const features = [
  {
    title: 'C++17 Header-Only Core',
    description: 'Zero external math dependencies. Every operation — matrix multiply, decompositions, solvers — built from scratch.',
    icon: '⚡',
  },
  {
    title: 'Python Bindings',
    description: 'pybind11 bindings give you a native Python Matrix class with numpy-style indexing, slicing, and negative indices.',
    icon: '🐍',
  },
  {
    title: 'Dimension Checking',
    description: 'Full dimension validation with informative ValueError on mismatches. No silent shape bugs.',
    icon: '✅',
  },
  {
    title: 'Follows Mathematics for ML',
    description: 'Chapter-by-chapter implementation after the book — linear algebra, analytic geometry, decompositions, calculus, probability, optimization.',
    icon: '📖',
  },
  {
    title: 'Published on PyPI',
    description: 'Installable via pip. scikit-build-core + CMake build system with Catch2 for testing.',
    icon: '📦',
  },
];

const roadmap = [
  { chapter: 'Ch 2', topic: 'Linear Algebra', status: 'done' },
  { chapter: 'Ch 3', topic: 'Analytic Geometry', status: 'planned' },
  { chapter: 'Ch 4', topic: 'Matrix Decompositions', status: 'planned' },
  { chapter: 'Ch 5', topic: 'Vector Calculus', status: 'planned' },
  { chapter: 'Ch 6', topic: 'Probability', status: 'planned' },
  { chapter: 'Ch 7', topic: 'Statistics', status: 'planned' },
  { chapter: 'Ch 8', topic: 'Optimization', status: 'planned' },
  { chapter: 'Ch 9', topic: 'Dimensions', status: 'planned' },
];
---

<BaseLayout title="Vecta — Computational Math for ML" description="A from-scratch C++17 computational maths library for machine learning with Python bindings." path="/vecta">
  <!-- HERO -->
  <section class="border-b border-border">
    <div class="page-container py-14 sm:py-20 lg:py-24">
      <div class="flex items-center gap-3 mb-5">
        <StatusBadge status="active" />
        <span class="font-mono text-xs text-text-muted">v0.0.3</span>
      </div>
      <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
        Vecta
      </h1>
      <p class="mt-2 font-mono text-sm text-accent-text">Computational Math for ML</p>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-text-secondary">
        A computational maths library for machine learning, built from scratch in C++17 with Python bindings — chapter by chapter after <em>Mathematics for Machine Learning</em>.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/vecta/docs" class="btn-primary">
          Read the docs <span aria-hidden="true">→</span>
        </a>
        <a href={socials.github} target="_blank" rel="noopener" class="btn-secondary">GitHub ↗</a>
      </div>

      <div class="mt-10 rounded-lg border border-border bg-surface p-4">
        <p class="mb-2 font-mono text-xs text-text-muted">Install</p>
        <code class="block font-mono text-sm text-text">pip install vecta-math</code>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="page-container py-16 sm:py-24">
    <p class="mb-2 font-mono text-sm text-accent-text">capabilities</p>
    <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">What it does</h2>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <div class="rounded-lg border border-border bg-surface p-5">
          <div class="text-2xl" aria-hidden="true">{f.icon}</div>
          <h3 class="mt-3 font-display font-bold">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">{f.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ROADMAP -->
  <section class="border-y border-border bg-surface">
    <div class="page-container py-16 sm:py-24">
      <p class="mb-2 font-mono text-sm text-accent-text">roadmap</p>
      <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">Chapter by chapter</h2>
      <p class="mt-3 max-w-xl text-text-secondary">Following <em>Mathematics for Machine Learning</em> — each chapter implemented from scratch in C++17.</p>
      <div class="mt-10 overflow-hidden rounded-lg border border-border">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-border bg-surface-2">
              <th class="px-4 py-2.5 font-mono text-xs text-text-muted">Chapter</th>
              <th class="px-4 py-2.5 font-mono text-xs text-text-muted">Topic</th>
              <th class="px-4 py-2.5 font-mono text-xs text-text-muted">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {roadmap.map((r) => (
              <tr>
                <td class="px-4 py-2.5 font-mono text-xs text-text-muted">{r.chapter}</td>
                <td class="px-4 py-2.5 font-medium">{r.topic}</td>
                <td class="px-4 py-2.5">
                  {r.status === 'done' ? (
                    <span class="inline-flex items-center gap-1 rounded-full border border-success/30 bg-success/10 px-2 py-0.5 font-mono text-[10px] text-success">
                      <span class="h-1.5 w-1.5 rounded-full bg-success" aria-hidden="true"></span>
                      done
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 rounded-full border border-border bg-surface-2 px-2 py-0.5 font-mono text-[10px] text-text-muted">
                      planned
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- QUICK START -->
  <section class="page-container py-16 sm:py-24">
    <p class="mb-2 font-mono text-sm text-accent-text">quick start</p>
    <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">Up and running</h2>
    <div class="mt-8 max-w-2xl overflow-hidden rounded-lg border border-border bg-code-bg">
      <div class="flex items-center gap-2 border-b border-border px-4 py-2">
        <span class="h-2.5 w-2.5 rounded-full bg-text-muted/30"></span>
        <span class="font-mono text-xs text-text-muted">example.py</span>
      </div>
      <pre class="overflow-x-auto p-4 font-mono text-sm leading-relaxed"><code><span class="text-text-muted">import</span> vecta

<span class="text-text-muted"># Create matrices</span>
A = vecta.Matrix([[<span class="text-accent-text">1</span>, <span class="text-accent-text">2</span>], [<span class="text-accent-text">3</span>, <span class="text-accent-text">4</span>]])
B = vecta.Matrix([[<span class="text-accent-text">5</span>, <span class="text-accent-text">6</span>], [<span class="text-accent-text">7</span>, <span class="text-accent-text">8</span>]])

<span class="text-text-muted"># Operations</span>
C = A @ B          <span class="text-text-muted"># matrix multiply</span>
T = A.transpose()  <span class="text-text-muted"># transpose</span>
I = vecta.eye(<span class="text-accent-text">3</span>)  <span class="text-text-muted"># identity</span>

<span class="text-text-muted"># Check properties</span>
A.is_symmetric()   <span class="text-text-muted"># True/False</span></code></pre>
    </div>
  </section>

  <!-- TECH STACK -->
  <section class="border-t border-border bg-surface">
    <div class="page-container py-16 sm:py-24">
      <p class="mb-2 font-mono text-sm text-accent-text">stack</p>
      <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">Built with</h2>
      <div class="mt-8 flex flex-wrap gap-2">
        {['C++17', 'pybind11', 'CMake', 'scikit-build-core', 'Catch2', 'uv'].map((t) => <Tag label={t} />)}
      </div>
    </div>
  </section>
</BaseLayout>