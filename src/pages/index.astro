---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import StatusBadge from '../components/StatusBadge.astro';
import Tag from '../components/Tag.astro';
import { projects, socials } from '../config/projects';

const tech: Record<string, string[]> = {
  hermes: ['Python', 'pandas', 'World Bank', 'IMF', 'GDELT', 'OpenSanctions'],
  sentinel: ['FastAPI', 'Dash', 'PostgreSQL', 'PyOD', 'Prophet', 'XGBoost', 'FinBERT'],
  aegis: ['FastAPI', 'Next.js', 'Redis', 'XGBoost', 'River'],
  atlas: ['TBD'],
  aletheia: ['Python', 'NumPy', 'pandas'],
  vecta: ['C++17', 'pybind11', 'CMake', 'Catch2'],
};

const skills = [
  {
    category: 'Languages',
    items: ['Python', 'C++17', 'TypeScript', 'JavaScript', 'SQL'],
  },
  {
    category: 'Data & ML',
    items: ['pandas', 'NumPy', 'scikit-learn', 'XGBoost', 'River'],
  },
  {
    category: 'Backend',
    items: ['FastAPI', 'Redis', 'Supabase', 'REST APIs'],
  },
  {
    category: 'Frontend',
    items: ['Next.js', 'React', 'Tailwind CSS', 'Astro'],
  },
  {
    category: 'Tooling',
    items: ['uv', 'CMake', 'pybind11', 'pytest', 'Git'],
  },
  {
    category: 'Data Sources',
    items: ['World Bank', 'IMF SDMX', 'GDELT', 'OpenSanctions', 'HDX'],
  },
];

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title="Haider Ali — Portfolio" path="/" description="Data platforms, ML tooling, and computational infrastructure built from scratch.">
  <!-- HERO -->
  <section class="border-b border-border">
    <div class="page-container grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-[1.15fr_1fr] lg:py-28">
      <div>
        <p class="mb-5 font-mono text-sm text-accent-text">
          software engineer — data &amp; ML infrastructure
        </p>
        <h1 class="font-display text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
          Haider Ali<span class="text-accent-text">.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-text-secondary">
          I build <span class="font-semibold text-text">data platforms</span>,
          <span class="font-semibold text-text">ML tooling</span>, and
          <span class="font-semibold text-text">computational infrastructure</span> —
          from country-risk pipelines to from-scratch math libraries in C++.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#projects" class="btn-primary">
            View projects
            <span aria-hidden="true">↓</span>
          </a>
          <a href={socials.github} target="_blank" rel="noopener" class="btn-secondary">
            GitHub ↗
          </a>
        </div>
      </div>

      <div class="overflow-hidden rounded-lg border border-border bg-surface">
        <div class="flex items-center justify-between border-b border-border px-4 py-3">
          <span class="font-mono text-xs text-text-muted">projects</span>
          <span class="font-mono text-xs text-text-muted">{projects.length} total</span>
        </div>
        <ul class="divide-y divide-border">
          {projects.map((p) => (
            <li>
              <a
                href={`/${p.slug}/docs`}
                class="group flex items-center justify-between gap-3 px-4 py-3 transition-colors hover:bg-surface-2"
              >
                <span class="flex min-w-0 items-center gap-2.5">
                  <StatusBadge status={p.status} dot />
                  <span class="truncate text-sm font-medium">{p.name}</span>
                </span>
                <span class="font-mono text-xs text-text-muted transition-colors group-hover:text-accent-text">
                  docs →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="page-container scroll-mt-16 py-16 sm:py-24">
    <div class="grid items-start gap-10 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <p class="mb-2 font-mono text-sm text-accent-text">about</p>
        <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">
          Built from scratch, shipped for real.
        </h2>
      </div>
      <div class="max-w-2xl space-y-4 leading-relaxed text-text-secondary">
        <p>
          I'm a software engineer who likes going deep: pulling data from messy external
          sources, engineering features from raw signals, and reimplementing the math that
          powers ML so it's actually understood.
        </p>
        <p>
          My projects range from <a href="/hermes" class="font-medium text-accent-text underline underline-offset-2 transition-colors hover:text-accent">Hermes</a>, a country-risk data platform that unifies five public data sources behind one API, to
          <a href="/vecta" class="font-medium text-accent-text underline underline-offset-2 transition-colors hover:text-accent">Vecta</a>, a C++17 library that rebuilds ML math chapter-by-chapter with zero external
          dependencies.
        </p>
        <p>
          Everything I build is open source and documented — because a tool nobody can
          understand or reuse isn't a tool at all.
        </p>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section id="skills" class="border-y border-border bg-surface">
    <div class="page-container py-16 sm:py-24">
      <SectionHeading kicker="stack" title="Tools & stack" />
      <div class="overflow-hidden rounded-lg border border-border bg-border">
        <div class="grid gap-px bg-border sm:grid-cols-2 lg:grid-cols-3">
          {skills.map((group) => (
            <div class="bg-background p-5">
              <div class="mb-3 font-mono text-[11px] uppercase tracking-[0.2em] text-accent-text">
                {group.category}
              </div>
              <div class="flex flex-wrap gap-1.5">
                {group.items.map((item) => <Tag label={item} />)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="page-container scroll-mt-16 py-16 sm:py-24">
    <SectionHeading
      kicker="projects"
      title="What I'm building"
      link={{ href: socials.github, label: 'github.com/ryomenhaider', external: true }}
    />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => <ProjectCard project={p} tech={tech[p.slug] ?? []} />)}
    </div>
  </section>

  <!-- BLOG -->
  <section id="blog" class="border-t border-border bg-surface">
    <div class="page-container py-16 sm:py-24">
      <SectionHeading kicker="writing" title="Latest writing" link={{ href: '/blog', label: 'all posts' }} />
      <div class="grid gap-4 md:grid-cols-3">
        {posts.map((post) => (
          <PostCard
            href={`/blog/${post.id.split('/').pop()}`}
            date={fmt.format(post.data.date)}
            title={post.data.title}
            description={post.data.description}
            tags={post.data.tags}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="page-container py-16 text-center sm:py-24">
    <p class="mb-3 font-mono text-sm text-accent-text">contact</p>
    <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Let's talk</h2>
    <p class="mx-auto mt-5 max-w-md leading-relaxed text-text-secondary">
      Open to collaborations, interesting problems, and feedback on the projects.
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
      <a href={socials.linkedin} target="_blank" rel="noopener" class="btn-primary">
        LinkedIn ↗
      </a>
      <a href={socials.x} target="_blank" rel="noopener" class="btn-secondary">
        X / Twitter ↗
      </a>
      <a href={socials.github} target="_blank" rel="noopener" class="btn-secondary">
        GitHub ↗
      </a>
    </div>
  </section>
</BaseLayout>