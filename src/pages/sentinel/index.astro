---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Tag from '../../components/Tag.astro';
import { socials } from '../../config/projects';

const features = [
  {
    title: '7 Dashboard Pages',
    description: 'Market Overview, Anomalies, Forecasts, Technical Analysis, Fundamental Analysis, Portfolio, and Sentiment — all in a Bloomberg-style React SPA.',
    icon: '📊',
  },
  {
    title: 'Anomaly Detection',
    description: 'Isolation Forest + LOF ensemble from PyOD, with severity labels and on-demand detection via API.',
    icon: '🔍',
  },
  {
    title: 'Forecasting',
    description: 'Prophet + XGBoost blended 50/50 with walk-forward cross-validation at 30/90-day horizons.',
    icon: '🔮',
  },
  {
    title: 'Portfolio Optimization',
    description: 'MPT, Black-Litterman, Kelly Criterion, and Blended allocation methods with efficient frontier visualization.',
    icon: '💼',
  },
  {
    title: 'Drift Detection',
    description: 'PSI + KS tests on 11 features against a 180-day baseline, with email and Slack alerts.',
    icon: '⚠️',
  },
  {
    title: 'CLI',
    description: 'stl ingest, stl ml-train, stl api-start — or stl all to run everything in sequence.',
    icon: '⌨️',
  },
];

const pages = [
  { name: 'Overview', desc: 'OHLCV candlesticks, KPI cards, top movers, auto-refresh' },
  { name: 'Anomalies', desc: 'Severity-coded markers, score timeline, CSV export' },
  { name: 'Forecasts', desc: 'Confidence bands, feature importance, model registry' },
  { name: 'Technical', desc: '86-field crypto snapshots — order book, funding, composites' },
  { name: 'Fundamental', desc: '71-field stock snapshots — income, balance, valuation' },
  { name: 'Portfolio', desc: 'Efficient frontier, allocation treemap, method comparison' },
  { name: 'Sentiment', desc: 'FinBERT scores, gauge, news timeline' },
];
---

<BaseLayout title="Sentinel — Financial Intelligence Platform" description="Real-time data ingestion, anomaly detection, time-series forecasting, and news-sentiment analytics served through a Bloomberg-style dashboard." path="/sentinel">
  <!-- HERO -->
  <section class="border-b border-border">
    <div class="page-container py-14 sm:py-20 lg:py-24">
      <div class="flex items-center gap-3 mb-5">
        <StatusBadge status="active" />
        <span class="font-mono text-xs text-text-muted">v0.3.0</span>
      </div>
      <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
        Sentinel
      </h1>
      <p class="mt-2 font-mono text-sm text-accent-text">Financial Intelligence Platform</p>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-text-secondary">
        Real-time data ingestion, anomaly detection, time-series forecasting, and news-sentiment analytics — served through a Bloomberg-style React dashboard with a FastAPI backend.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/sentinel/docs" class="btn-primary">
          Read the docs <span aria-hidden="true">→</span>
        </a>
        <a href={socials.github} target="_blank" rel="noopener" class="btn-secondary">GitHub ↗</a>
        <a href="https://sentinel-fint.vercel.app" target="_blank" rel="noopener" class="btn-secondary">Try it live ↗</a>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="page-container py-16 sm:py-24">
    <p class="mb-2 font-mono text-sm text-accent-text">capabilities</p>
    <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">What it does</h2>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <div class="rounded-lg border border-border bg-surface p-5">
          <div class="text-2xl" aria-hidden="true">{f.icon}</div>
          <h3 class="mt-3 font-display font-bold">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">{f.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- DASHBOARD PAGES -->
  <section class="border-y border-border bg-surface">
    <div class="page-container py-16 sm:py-24">
      <p class="mb-2 font-mono text-sm text-accent-text">dashboard</p>
      <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">7 React pages</h2>
      <p class="mt-3 max-w-xl text-text-secondary">Bloomberg-style dark theme with Plotly.js charts, lazy-loaded via React.lazy().</p>
      <div class="mt-10 overflow-hidden rounded-lg border border-border">
        <div class="grid gap-px bg-border sm:grid-cols-2 lg:grid-cols-4">
          {pages.map((p) => (
            <div class="bg-background p-4">
              <div class="font-display font-bold">{p.name}</div>
              <div class="mt-1 text-sm text-text-secondary">{p.desc}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ARCHITECTURE -->
  <section class="page-container py-16 sm:py-24">
    <p class="mb-2 font-mono text-sm text-accent-text">architecture</p>
    <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">How it's built</h2>
    <div class="mt-8 max-w-2xl overflow-hidden rounded-lg border border-border bg-code-bg p-4">
      <pre class="overflow-x-auto font-mono text-sm leading-relaxed"><code>┌──────────────────────────────┐
│   FastAPI :7860              │
│   /api/v1/*  →  routers      │
│   /api/docs  →  Swagger UI   │
└──────────────┬───────────────┘
               │
┌──────────────▼───────────────┐
│   PostgreSQL (SQLAlchemy)    │
│   Supabase / local / managed │
└──────────────────────────────┘

Frontend: React 19 + Vite + Plotly.js (Render)
ML: PyOD · Prophet · XGBoost · FinBERT · MLflow</code></pre>
    </div>
  </section>

  <!-- TECH STACK -->
  <section class="border-t border-border bg-surface">
    <div class="page-container py-16 sm:py-24">
      <p class="mb-2 font-mono text-sm text-accent-text">stack</p>
      <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">Built with</h2>
      <div class="mt-8 flex flex-wrap gap-2">
        {['Python 3.12', 'FastAPI', 'SQLAlchemy', 'React 19', 'Vite', 'Plotly.js', 'PyOD', 'Prophet', 'XGBoost', 'FinBERT', 'MLflow', 'hermes-plt'].map((t) => <Tag label={t} />)}
      </div>
    </div>
  </section>
</BaseLayout>