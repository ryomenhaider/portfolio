---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title="Blog — Haider Ali" path="/blog" description="Writing about data platforms, ML tooling, and building things from scratch.">
  <section class="border-b border-border">
    <div class="page-container py-14 sm:py-20">
      <p class="mb-3 font-mono text-sm text-accent-text">writing</p>
      <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Blog</h1>
      <p class="mt-3 max-w-lg leading-relaxed text-text-secondary">
        Notes on data platforms, ML math, and building software from scratch.
      </p>
    </div>
  </section>

  <section class="page-container py-12 sm:py-16">
    {posts.length === 0 ? (
      <p class="font-mono text-sm text-text-muted">No posts yet — check back soon.</p>
    ) : (
      <div class="divide-y divide-border border-y border-border">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id.split('/').pop()}`}
            class="group -mx-4 flex flex-col gap-2 rounded-lg px-4 py-6 transition-colors hover:bg-surface/60 sm:-mx-6 sm:px-6 sm:py-7"
          >
            <div class="font-mono text-xs text-text-muted">
              {fmt.format(post.data.date)}
              {post.data.tags.length > 0 && (
                <span class="ml-3 text-accent-text">
                  {post.data.tags.map((t) => `#${t}`).join(' ')}
                </span>
              )}
            </div>
            <h2 class="font-display text-xl font-bold tracking-tight transition-colors group-hover:text-accent-text sm:text-2xl">
              {post.data.title}
            </h2>
            <p class="max-w-2xl text-sm leading-relaxed text-text-secondary">
              {post.data.description}
            </p>
            <span class="mt-1 text-sm font-semibold text-accent-text">
              Read post →
            </span>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>